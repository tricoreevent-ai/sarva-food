{
  "name": "Nammude",
  "short_name": "Nammude",
  "description": "Nammude connects customers directly with local restaurant owners for transparent ordering, real-time menus, exclusive offers, and no third-party intermediaries.",
  "start_url": "/splash",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#FDF3E8",
  "theme_color": "#3B7A32",
  "categories": ["food", "shopping", "business"],
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "16x16 32x32 48x48",
      "type": "image/x-icon"
    },
    {
      "src": "/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/nammude-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/nammude-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/nammude-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Browse Restaurants",
      "short_name": "Restaurants",
      "url": "/restaurants",
      "icons": [{ "src": "/icons/nammude-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Track Order",
      "short_name": "Track",
      "url": "/track-order",
      "icons": [{ "src": "/icons/nammude-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Open Cart",
      "short_name": "Cart",
      "url": "/cart",
      "icons": [{ "src": "/icons/nammude-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Owner POS",
      "short_name": "POS",
      "url": "/pos",
      "icons": [{ "src": "/icons/nammude-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
