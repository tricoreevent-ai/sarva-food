{
  "name": "sarva-food-commerce-ecosystem",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/clean-next-dev-cache.mjs && next dev --webpack --hostname 0.0.0.0 --port 3000",
    "dev:lan": "node scripts/show-lan-ip.mjs && node scripts/clean-next-dev-cache.mjs && next dev --webpack --hostname 0.0.0.0 --port 3000",
    "dev:cert": "node scripts/generate-dev-cert.mjs",
    "dev:lan:https": "node scripts/generate-dev-cert.mjs && node scripts/https-dev-server.mjs",
    "dev:lan:https:proxy": "node scripts/generate-dev-cert.mjs && node scripts/https-dev-server.mjs --existing",
    "dev:staging": "next dev --experimental-https",
    "build": "node scripts/build-next-with-middleware-trace.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "theme:contrast": "node scripts/validate-theme-contrast.mjs",
    "validate:prod-env": "node scripts/validate-production-env.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "firebase:emulators": "npx firebase-tools emulators:start --only auth,firestore,storage,functions",
    "firebase:emulators:export": "npx firebase-tools emulators:export ./tmp/firebase-emulator-data",
    "firebase:deploy:rules": "npx firebase-tools deploy --only firestore:rules,storage",
    "firebase:deploy:indexes": "npx firebase-tools deploy --only firestore:indexes",
    "firebase:seed:production": "node scripts/seed-firebase-production.mjs",
    "firebase:seed:owner-client": "node scripts/seed-firebase-owner-client.mjs",
    "firebase:repair:banners": "node scripts/repair-restaurant-banner-media.mjs",
    "firebase:cleanup:dry-run": "node scripts/firestore-production-cleanup.mjs",
    "firebase:cleanup:apply": "node scripts/firestore-production-cleanup.mjs --apply",
    "firebase:legacy-menu:dry-run": "node scripts/remove-legacy-seeded-menu-items.mjs",
    "firebase:legacy-menu:apply": "node scripts/remove-legacy-seeded-menu-items.mjs --apply",
    "firebase:validate:production-data": "node scripts/validate-production-data.mjs",
    "firebase:deploy:functions": "npx firebase-tools deploy --only functions",
    "firebase:deploy:hosting": "npx firebase-tools deploy --only hosting",
    "firebase:deploy": "npx firebase-tools deploy",
    "deploy:staging": "npm run verify && npx firebase-tools deploy --project staging",
    "deploy:production": "npm run verify && npx firebase-tools deploy --project production"
  },
  "overrides": {
    "@stackframe/stack": {
      "lucide-react": "0.508.0"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@stackframe/stack": "^2.8.108",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "12.38.0",
    "lucide-react": "1.14.0",
    "mapbox-gl": "^3.23.1",
    "next": "16.2.6",
    "nodemailer": "^8.0.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.75.0",
    "react-hot-toast": "^2.6.0",
    "react-map-gl": "^8.1.1",
    "tailwind-merge": "3.5.0",
    "xlsx": "^0.18.5",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  }
}
